---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>
  <section class="max-w-xl mx-auto px-4 pt-16 pb-20 text-center">
    <h1 class="text-2xl md:text-3xl font-semibold mb-3">Mahalo for your order.</h1>
    <p class="text-sm text-slate-300 mb-4">Your checkout is being securely processed by Square.</p>
    <a href="/" class="inline-flex items-center rounded-full border border-slate-700 px-4 py-2 text-sm hover:border-emerald-300 hover:text-emerald-200 transition">Back to shop</a>
  </section>
</BaseLayout>
